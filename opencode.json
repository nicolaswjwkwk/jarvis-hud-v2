{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": true,
  "share": "disabled",

  "model": "groq/llama-3.3-70b-versatile",
  "small_model": "groq/llama-3.1-8b-instant",

  "instructions": ["AGENTS.md", ".opencode/rules/jarvis.md"],

  "agent": {
    "build": {
      "mode": "primary",
      "description": "Agente principal de desenvolvimento com acesso total a ferramentas",
      "permission": { "edit": "allow", "bash": "allow", "webfetch": "allow" }
    },
    "plan": {
      "mode": "primary",
      "description": "Analisa código e sugere mudanças sem alterar arquivos",
      "permission": { "edit": "deny", "bash": "ask" }
    },
    "review": {
      "mode": "subagent",
      "description": "Revisa código em busca de bugs, segurança e qualidade",
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "security": {
      "mode": "subagent",
      "description": "Auditoria de segurança: injeção, XSS, segredos expostos, permissões amplas",
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "docs": {
      "mode": "subagent",
      "description": "Gera e atualiza documentação Markdown do projeto",
      "permission": { "edit": "allow", "bash": "deny" }
    },
    "commit": {
      "mode": "subagent",
      "description": "Escreve mensagens de commit convencionais e organiza o staging",
      "permission": { "edit": "allow", "bash": "allow" }
    }
  },

  "mcp": {
    "jarvis-hud": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": false
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "git push*": "ask"
    },
    "webfetch": "allow"
  },

  "provider": {

    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Groq",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "llama-3.1-8b-instant": { "name": "Llama 3.1 8B Instant" },
        "llama-3.3-70b-versatile": { "name": "Llama 3.3 70B Versatile" },
        "meta-llama/llama-4-scout-17b-16e-instruct": { "name": "Llama 4 Scout 17B" },
        "moonshotai/kimi-k2-instruct": { "name": "Kimi K2 Instruct" },
        "qwen/qwen3-32b": { "name": "Qwen3 32B" },
        "openai/gpt-oss-120b": { "name": "GPT-OSS 120B" },
        "openai/gpt-oss-20b": { "name": "GPT-OSS 20B" }
      }
    },

    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (grátis)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
